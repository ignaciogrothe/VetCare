# Copie este archivo como .env y complete sus datos.
# El archivo .env NO se sube al repositorio.

# Atlas (pegue aqui la cadena que entrega el boton "Connect" -> "Drivers")
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# MongoDB instalado en su propio computador (alternativa sin internet)
# MONGO_URI=mongodb://localhost:27017

MONGO_DB=veterinaria
